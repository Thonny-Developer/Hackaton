# Скопируйте в .env (в корне репозитория) и замените все секреты: openssl rand -hex 32

# Домен для HTTPS (Caddy сам получит сертификат). Без домена: DOMAIN=:80
DOMAIN=:80

# Адреса, с которых браузер может ходить в API с другого домена. В Docker фронт и API на одном
# домене, это нужно только для `npm run dev` (Vite на :5173)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=replace-with-64-hex-chars
JWT_TTL_MINUTES=720

POSTGRES_USER=sapa
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=sapa

MINIO_ROOT_USER=sapa
MINIO_ROOT_PASSWORD=replace-with-strong-password
MINIO_BUCKET=floor-plans

# Лимиты запросов с одного IP
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ROUTE=30/minute
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_OUTDOOR=10/minute

# Внешние API (необязательно). Без ключа функция отключается, остальное работает.
DGIS_API_KEY=
ORS_API_KEY=

# Число воркеров uvicorn и создание демо-здания при старте
WORKERS=2
SEED_DEMO=true

# Фронтенд (встраивается в сборку). Публичный токен Mapbox (pk...), ограничьте его доменом в кабинете Mapbox
VITE_MAPBOX_ACCESS_TOKEN=
# Адрес API для фронта. "/" = тот же домен, что и сайт (так и работает в Docker)
VITE_API_BASE_URL=/

# Почта через Gmail. SMTP_USER = адрес Gmail, SMTP_PASSWORD = пароль приложения (16 символов),
# его выдают на https://myaccount.google.com/apppasswords (нужна двухэтапная аутентификация).
# Пустой SMTP_HOST = почта выключена. Проверка: docker compose exec api python -m app.cli test-email --to you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Отправитель. Пусто = SMTP_USER. Gmail разрешает только свой адрес или подтверждённый алиас
SMTP_FROM=
# Адрес сайта для ссылок в письмах (сброс пароля)
PUBLIC_URL=http://localhost
# Письмо админам, когда отмечено новое препятствие
NOTIFY_OBSTACLES=true
